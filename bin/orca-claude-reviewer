#!/usr/bin/env python3

import argparse
from pathlib import Path
import re
import shutil
import subprocess
import sys


VALID_VERDICTS = (
    "PASS",
    "CHANGES_REQUIRED",
    "ESCALATION_REQUIRED",
)


def read_text(path):
    p = Path(path).expanduser().resolve()

    if not p.exists():
        raise SystemExit(f"ERROR: file does not exist: {p}")

    if not p.is_file():
        raise SystemExit(f"ERROR: not a regular file: {p}")

    return p.read_text(encoding="utf-8", errors="replace")


def validate_preamble(text):
    required = (
        "Your task ID is:",
        "worker_done",
        "--dispatch-id",
        "--from",
    )

    missing = [x for x in required if x not in text]

    if missing:
        raise SystemExit(
            "ERROR: preamble is missing required Orca lifecycle markers: "
            + ", ".join(missing)
        )


def extract_lifecycle_ids(preamble):
    import re

    task_match = re.search(
        r"(?m)^Your task ID is:\s*(task_[A-Za-z0-9_-]+)\s*$",
        preamble,
    )

    from_match = re.search(
        r"--from\s+(term_[A-Za-z0-9_-]+)",
        preamble,
    )

    dispatch_match = re.search(
        r"--dispatch-id\s+(ctx_[A-Za-z0-9_-]+)",
        preamble,
    )

    if not task_match:
        raise ValueError("Task ID not found in Orca preamble")

    if not from_match:
        raise ValueError("assignee terminal handle not found in Orca preamble")

    if not dispatch_match:
        raise ValueError("Dispatch ID not found in Orca preamble")

    return {
        "task_id": task_match.group(1),
        "terminal_id": from_match.group(1),
        "dispatch_id": dispatch_match.group(1),
    }


def build_prompt(preamble, task):
    return f"""You are the INDEPENDENT REVIEWER for an Orca multi-agent Run.

You are running through Claude Code using its locally configured backend.

ROLE CONTRACT

You are a Reviewer, not an Executor.

You MUST:
- independently inspect the actual implementation and evidence;
- evaluate it against the bounded review Task and acceptance criteria;
- distinguish technical defects from non-blocking observations;
- report concrete evidence for every blocking finding;
- preserve the user's existing dirty worktree and unrelated work;
- remain independent from the Executor's reasoning.

You MUST NOT:
- edit, create, delete, rename, format, or rewrite project files;
- fix defects yourself;
- silently expand the Task scope;
- create another Orca Run, Task, or Dispatch;
- reuse stale lifecycle identifiers;
- claim tests passed unless you actually verified the cited evidence or ran them;
- treat documentation style issues as technical failures unless the contract
  explicitly makes them acceptance criteria.

You may inspect files, diffs, logs, reports, and repository state.
You may run bounded read-only diagnostics or validation commands when the
review Task explicitly permits them.

The Orca Dispatch preamble below is authoritative for Task identity and
lifecycle provenance. Do not send worker_done yourself. The adapter that
launched you owns lifecycle settlement after parsing your final verdict.

FINAL OUTPUT CONTRACT

Your final output must contain exactly one final verdict line in this form:

FINAL_VERDICT: PASS

or:

FINAL_VERDICT: CHANGES_REQUIRED

or:

FINAL_VERDICT: ESCALATION_REQUIRED

Before that line, provide a concise evidence-backed review.

If CHANGES_REQUIRED, enumerate the minimal required fixes.
If ESCALATION_REQUIRED, state the specific unresolved conflict or ambiguity.
Do not place any text after the FINAL_VERDICT line.

================ ORCA DISPATCH PREAMBLE ================

{preamble}

================ REVIEW TASK ================

{task}
"""


def extract_verdict(output):
    matches = re.findall(
        r"(?m)^FINAL_VERDICT:\s*"
        r"(PASS|CHANGES_REQUIRED|ESCALATION_REQUIRED)\s*$",
        output,
    )

    if len(matches) != 1:
        raise ValueError(
            "review output must contain exactly one valid FINAL_VERDICT line"
        )

    return matches[0]


def main():
    parser = argparse.ArgumentParser(
        description="Run Claude / configured GLM backend as an independent Orca Reviewer."
    )

    parser.add_argument(
        "--preamble-file",
        required=True,
        help="File containing the exact Orca dispatch preamble.",
    )

    parser.add_argument(
        "--task-file",
        required=True,
        help="File containing the bounded Reviewer task.",
    )

    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="Validate inputs and print the composed review prompt only.",
    )

    parser.add_argument(
        "--parse-output",
        help="Parse an existing reviewer output file and print its verdict.",
    )

    args = parser.parse_args()

    preamble = read_text(args.preamble_file)
    task = read_text(args.task_file)

    validate_preamble(preamble)

    try:
        lifecycle = extract_lifecycle_ids(preamble)
    except ValueError as e:
        raise SystemExit(f"ERROR: {e}")

    if not task.strip():
        raise SystemExit("ERROR: task file is empty")

    if args.parse_output:
        output = read_text(args.parse_output)

        try:
            verdict = extract_verdict(output)
        except ValueError as e:
            raise SystemExit(f"ERROR: {e}")

        print(verdict)
        return

    prompt = build_prompt(preamble, task)

    if args.dry_run:
        print(prompt)
        return

    claude = shutil.which("claude")

    if not claude:
        raise SystemExit("ERROR: claude not found in PATH")

    result = subprocess.run(
        [
            claude,
            "--print",
            "--no-session-persistence",
            "--permission-mode",
            "plan",
            prompt,
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=sys.stderr,
        check=False,
    )

    if result.returncode != 0:
        raise SystemExit(result.returncode)

    output = result.stdout
    print(output, end="")

    try:
        verdict = extract_verdict(output)
    except ValueError as e:
        raise SystemExit(f"\nERROR: {e}")

    body = (
        "Independent review completed under the bounded Orca review task. "
        f"Final verdict: {verdict}. "
        "The evidence-backed findings are present in the reviewer terminal output."
    )

    send = subprocess.run(
        [
            "orca",
            "orchestration",
            "send",
            "--from",
            lifecycle["terminal_id"],
            "--type",
            "worker_done",
            "--subject",
            verdict,
            "--body",
            body,
            "--task-id",
            lifecycle["task_id"],
            "--dispatch-id",
            lifecycle["dispatch_id"],
            "--outcome",
            "succeeded",
        ],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )

    if send.returncode != 0:
        sys.stderr.write(send.stderr)
        raise SystemExit(
            "\nERROR: reviewer verdict was produced but Orca worker_done settlement failed"
        )

    print()
    print("ORCA_REVIEWER_WORKER_DONE_SENT")


if __name__ == "__main__":
    main()
